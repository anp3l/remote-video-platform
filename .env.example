# =============================================================================
# Remote Video Platform v2.0.0 - Local Development Configuration
# =============================================================================
# This configuration is optimized for local testing and demonstration.
# Copy this file to `.env` and fill in your secrets.
# NEVER commit the `.env` file to Git.

# -----------------------------------------------------------------------------
# RSA Keys (RS256 JWT Authentication)
# -----------------------------------------------------------------------------
# Generate RSA keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Convert to Base64:
#   Linux/Mac:    cat private.pem | base64 | tr -d '\n'
#   Windows:      [Convert]::ToBase64String([IO.File]::ReadAllBytes("./private.pem"))

PRIVATE_KEY_BASE64=your_base64_encoded_private_key_here
PUBLIC_KEY_BASE64=your_base64_encoded_public_key_here

# -----------------------------------------------------------------------------
# JWT Token Configuration
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRY=15m    # Short-lived tokens for API requests
REFRESH_TOKEN_EXPIRY=7d    # Long-lived tokens for renewal

# -----------------------------------------------------------------------------
# Video Streaming Security
# -----------------------------------------------------------------------------
# Generate secret:   openssl rand -base64 32

STREAM_SECRET=your_random_base64_stream_secret_here

# -----------------------------------------------------------------------------
# Email Configuration (Mock Mode - Logs to Console)
# -----------------------------------------------------------------------------
EMAIL_FROM=noreply@demo.com
SUPPORT_EMAIL=support@demo.com
