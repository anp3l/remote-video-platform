# =============================================================================
# Remote Video Platform - Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your secrets before running.
# NEVER commit the `.env` file to Git.

# -----------------------------------------------------------------------------
# RSA Keys (RS256 JWT Authentication)
# -----------------------------------------------------------------------------
# Generate RSA keys with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Convert to Base64 (Linux/Mac):
#   cat private.pem | base64 | tr -d '\n'
#   cat public.pem | base64 | tr -d '\n'
#
# Convert to Base64 (Windows PowerShell):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("./private.pem"))

PRIVATE_KEY_BASE64=your_base64_encoded_private_key_here
PUBLIC_KEY_BASE64=your_base64_encoded_public_key_here

# -----------------------------------------------------------------------------
# Video Streaming Security
# -----------------------------------------------------------------------------
# Generate a random HMAC secret for signed streaming URLs:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

STREAM_SECRET=your_random_base64_stream_secret_here

